# ---------------------------------------------------------------------------
# CI "initial creation" policy (ADMIN-MANAGED, attached to the CI user)
#
# Lets GitHub Actions create the network (VPC), the two EKS IAM roles (only with the
# permissions boundary), the EKS secrets KMS key and the node launch template.
#
# Design rules
#   * CREATE-ONLY. There are no Delete*, Release*, Detach*, Disassociate* or Schedule*
#     actions, so CI cannot destroy any of this (the workflow's delete guard enforces
#     the same rule on the plan; this enforces it in IAM).
#   * CI can NOT manage its own identity. The CI user, both CI policies, the admin
#     EC2/VPC policy and the permissions boundary are admin-only: they are explicitly
#     denied below (the workflow has no resource-type allow-list, so IAM is the control).
#     Otherwise CI could edit its own policy or attach AdministratorAccess to itself.
#   * Everything is limited to var.aws_region and, where AWS supports it, to resources
#     tagged Project=<project_name> (the provider's default_tags put that tag on every
#     resource Terraform creates).
#
# Unavoidable wildcards (each is documented next to its statement and in
# docs/OPERATIONS.md): resource IDs generated by AWS (vpc/*, subnet/*, key/*, ...) and
# kms:CreateKey / security-group rule revocation for the VPC default security group.
#
# NOT verified against a real account: tag-based conditions on EC2 actions are
# AWS-documented but must be confirmed by a real run; see docs/OPERATIONS.md.
# ---------------------------------------------------------------------------
locals {
  ec2_arn = "${local.arn_prefix}:ec2:${var.aws_region}:${local.account_id}"
  kms_arn = "${local.arn_prefix}:kms:${var.aws_region}:${local.account_id}"

  ec2_create_actions = [
    "CreateVpc", "CreateSubnet", "CreateInternetGateway", "CreateRouteTable",
    "AllocateAddress", "CreateNatGateway", "CreateLaunchTemplate",
  ]

  # Every identity/policy that must stay unreachable for CI.
  ci_protected_iam_arns = [
    "${local.arn_prefix}:iam::${local.account_id}:user/ci/${local.github_user_name}",
    "${local.arn_prefix}:iam::${local.account_id}:policy/${local.deploy_policy}",
    "${local.arn_prefix}:iam::${local.account_id}:policy/${local.deploy_create_policy}",
    "${local.arn_prefix}:iam::${local.account_id}:policy/${local.admin_ec2_vpc_policy_name}",
    local.role_boundary_arn,
  ]
}

data "aws_iam_policy_document" "github_deploy_create" {
  # --- EC2/VPC: create resources (tagged at creation) -----------------------
  # Resource "*" is required: a VPC, subnet, gateway, route table, Elastic IP, NAT
  # gateway or launch template has no ARN before it exists. The request must carry
  # Project=<project_name>, so CI can only create resources tagged as this project's.
  statement {
    sid       = "Ec2CreateTaggedResources"
    actions   = [for a in local.ec2_create_actions : "ec2:${a}"]
    resources = ["*"] # documented wildcard: new resources have no ARN yet
    condition {
      test     = "StringEquals"
      variable = "aws:RequestedRegion"
      values   = [var.aws_region]
    }
    condition {
      test     = "StringEquals"
      variable = "aws:RequestTag/Project"
      values   = [var.project_name]
    }
  }

  # Tagging at creation is allowed only as part of those create calls.
  statement {
    sid     = "Ec2TagOnCreateOnly"
    actions = ["ec2:CreateTags"]
    resources = [
      "${local.ec2_arn}:vpc/*", "${local.ec2_arn}:subnet/*", "${local.ec2_arn}:internet-gateway/*",
      "${local.ec2_arn}:route-table/*", "${local.ec2_arn}:elastic-ip/*", "${local.ec2_arn}:natgateway/*",
      "${local.ec2_arn}:launch-template/*",
    ]
    condition {
      test     = "StringEquals"
      variable = "ec2:CreateAction"
      values   = local.ec2_create_actions
    }
  }

  # --- EC2/VPC: wire up and tune resources that carry this project's tag ----
  # IDs are generated by AWS, so the ARNs end in /*; the Project tag is what scopes
  # them. No Delete/Detach/Disassociate/Release actions exist anywhere in this policy.
  statement {
    sid = "Ec2ChangeProjectTaggedResources"
    actions = [
      "ec2:ModifyVpcAttribute", "ec2:ModifySubnetAttribute", "ec2:AttachInternetGateway",
      "ec2:CreateRoute", "ec2:ReplaceRoute", "ec2:AssociateRouteTable",
      "ec2:CreateLaunchTemplateVersion", "ec2:ModifyLaunchTemplate", "ec2:CreateTags",
    ]
    resources = [
      "${local.ec2_arn}:vpc/*", "${local.ec2_arn}:subnet/*", "${local.ec2_arn}:internet-gateway/*",
      "${local.ec2_arn}:route-table/*", "${local.ec2_arn}:launch-template/*",
    ]
    condition {
      test     = "StringEquals"
      variable = "aws:ResourceTag/Project"
      values   = [var.project_name]
    }
  }

  # aws_default_security_group adopts the VPC's default security group and removes its
  # default rules. That group is created by AWS with no tags, so it cannot be scoped by
  # tag or name: this statement applies to any security group in the region. Accepted
  # limitation (it can only REMOVE rules, never open traffic; no Authorize* actions).
  statement {
    sid       = "Ec2LockDownDefaultSecurityGroup"
    actions   = ["ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress"]
    resources = ["${local.ec2_arn}:security-group/*"] # documented wildcard
  }

  statement {
    sid       = "Ec2TagDefaultSecurityGroup"
    actions   = ["ec2:CreateTags"]
    resources = ["${local.ec2_arn}:security-group/*"] # documented wildcard (see above)
    condition {
      test     = "StringEquals"
      variable = "aws:RequestTag/Project"
      values   = [var.project_name]
    }
    condition {
      test     = "ForAllValues:StringEquals"
      variable = "aws:TagKeys"
      values   = ["Name", "Project", "ManagedBy"]
    }
  }

  # --- IAM: only the two EKS roles, only with the permissions boundary ------
  statement {
    sid       = "IamCreateEksRolesWithBoundary"
    actions   = ["iam:CreateRole"]
    resources = [local.eks_cluster_role_arn, local.eks_node_role_arn]
    condition {
      test     = "StringEquals"
      variable = "iam:PermissionsBoundary"
      values   = [local.role_boundary_arn]
    }
  }

  statement {
    sid       = "IamTagEksRoles"
    actions   = ["iam:TagRole"]
    resources = [local.eks_cluster_role_arn, local.eks_node_role_arn]
  }

  # Only the AWS-managed policies the roles are designed to have.
  statement {
    sid       = "IamAttachApprovedManagedPolicies"
    actions   = ["iam:AttachRolePolicy"]
    resources = [local.eks_cluster_role_arn, local.eks_node_role_arn]
    condition {
      test     = "ArnEquals"
      variable = "iam:PolicyARN"
      values   = local.eks_role_managed_policy_arns
    }
  }

  # The cluster role's inline KMS policy. Inline policy CONTENT cannot be restricted by
  # IAM conditions; the permissions boundary is what caps what such a policy can grant.
  statement {
    sid       = "IamPutClusterRoleInlinePolicy"
    actions   = ["iam:PutRolePolicy"]
    resources = [local.eks_cluster_role_arn]
  }

  # The boundary can never be removed or swapped from CI.
  statement {
    sid       = "DenyBoundaryChangesOnEksRoles"
    effect    = "Deny"
    actions   = ["iam:DeleteRolePermissionsBoundary", "iam:PutRolePermissionsBoundary"]
    resources = [local.eks_cluster_role_arn, local.eks_node_role_arn]
  }

  # CI cannot change its own user, either CI policy, the admin policy or the boundary
  # (no self-escalation). Explicit deny wins over any allow, even a mistaken one later.
  statement {
    sid    = "DenyCiSelfAndPolicyChanges"
    effect = "Deny"
    actions = [
      "iam:AttachUserPolicy", "iam:DetachUserPolicy", "iam:PutUserPolicy", "iam:DeleteUserPolicy",
      "iam:PutUserPermissionsBoundary", "iam:DeleteUserPermissionsBoundary",
      "iam:UpdateUser", "iam:DeleteUser", "iam:CreateAccessKey", "iam:UpdateAccessKey",
      "iam:CreatePolicyVersion", "iam:SetDefaultPolicyVersion", "iam:DeletePolicyVersion",
      "iam:DeletePolicy", "iam:TagPolicy", "iam:UntagPolicy", "iam:TagUser", "iam:UntagUser",
    ]
    resources = local.ci_protected_iam_arns
  }

  # --- KMS: the EKS secrets key ---------------------------------------------
  # kms:CreateKey cannot be limited to a key ARN (none exists yet) and kms:TagResource is
  # evaluated against "*" when tagging at creation. Both therefore use Resource "*" but
  # only succeed when the request is tagged Project=<project_name>, ManagedBy=terraform
  # and targets var.aws_region. No PutKeyPolicy and no ScheduleKeyDeletion: CI can never
  # rewrite a key policy or delete a key.
  statement {
    sid       = "KmsCreateProjectKey"
    actions   = ["kms:CreateKey", "kms:TagResource"]
    resources = ["*"] # documented wildcard: AWS requires "*" for CreateKey
    condition {
      test     = "StringEquals"
      variable = "aws:RequestTag/Project"
      values   = [var.project_name]
    }
    condition {
      test     = "StringEquals"
      variable = "aws:RequestTag/ManagedBy"
      values   = ["terraform"]
    }
    condition {
      test     = "StringEquals"
      variable = "aws:RequestedRegion"
      values   = [var.aws_region]
    }
  }

  statement {
    sid       = "KmsEnableRotationOnProjectKeys"
    actions   = ["kms:EnableKeyRotation"]
    resources = ["${local.kms_arn}:key/*"] # key ID unknown until created; tag-scoped below
    condition {
      test     = "StringEquals"
      variable = "aws:ResourceTag/Project"
      values   = [var.project_name]
    }
  }

  # Creating an alias needs permission on the alias AND on the target key.
  statement {
    sid       = "KmsCreateSecretsAlias"
    actions   = ["kms:CreateAlias"]
    resources = ["${local.kms_arn}:${local.kms_alias_name}"]
  }

  statement {
    sid       = "KmsAliasTargetKey"
    actions   = ["kms:CreateAlias"]
    resources = ["${local.kms_arn}:key/*"] # key ID unknown until created; tag-scoped below
    condition {
      test     = "StringEquals"
      variable = "aws:ResourceTag/Project"
      values   = [var.project_name]
    }
  }
}

resource "aws_iam_policy" "github_deploy_create" {
  name        = local.deploy_create_policy
  description = "ADMIN-MANAGED: create-only permissions for GitHub Actions initial provisioning of ${var.project_name} (network, EKS roles behind a boundary, KMS key, launch template)."
  policy      = data.aws_iam_policy_document.github_deploy_create.json
}

resource "aws_iam_user_policy_attachment" "github_deploy_create" {
  user       = aws_iam_user.github_actions.name
  policy_arn = aws_iam_policy.github_deploy_create.arn
}
